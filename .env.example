# PhishGuard AI – Environment Configuration
# MERN Stack Cybersecurity Architecture

PORT=8000
NODE_ENV=development

# MongoDB URI (Supports Local MongoDB and MongoDB Atlas)
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/phishguard_ai
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/phishguard_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=phishguard_super_secure_major_project_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Default System Administrator Bootstrap Credentials
ADMIN_EMAIL=admin@phishguard.ai
ADMIN_PASSWORD=Admin@PhishGuard2026!

# Threat Intelligence Optional API Keys
# Leave empty if you don't have keys; the system applies heuristic & ML detection without them
GOOGLE_SAFE_BROWSING_API_KEY=
OPENPHISH_API_KEY=
